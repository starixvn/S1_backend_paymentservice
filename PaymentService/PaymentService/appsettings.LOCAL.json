{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sentry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Sentry",
        "Args": {
          "Dsn": "https://5be095816a4dc5d30e5a7f9b614c2a65@sentry-s1.nexentgame.com/7",
          "SendDefaultPii": true,
          "MaxRequestBodySize": "Always",
          "MinimumBreadcrumbLevel": "Debug",
          "MinimumEventLevel": "Warning",
          "AttachStackTrace": true,
          "Debug": true,
          "DiagnosticLevel": "Error",
          "TracesSampleRate": 1.0,
          "Environment": "LOCAL",
          "DefaultTags": {
            "Solution": "Payment"
          }
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "ConfigService": [ "https://s1-config-service.nexdev.net/" ]
}
