{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/logs/payment/payment-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ConfigService": [ "http://ecs.nova88dev.com:7243/" ],
  "CallBack": "https://payment.n88dev.com", //Stage
  "ProxyHost": null,
  "ProxyPort": 0,
  "OutgoingIp": "218.211.34.185",
  "OfficeIP": [ "111.235.220.80", "211.75.236.133", "0.0.0.1", "125.227.148.97" ]
}
