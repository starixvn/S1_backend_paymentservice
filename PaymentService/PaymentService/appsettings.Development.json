{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/payment/payment-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ElasticApm": {
    "ServiceName": "PaymentService",
    "ServiceVersion": "v1.0",
    "Environment": "Development",
    "LogLevel": "Info",
    "ServerUrl": "http://172.31.48.203:8200",
    "TransactionIgnoreUrls": "/health",
    "TransactionSampleRate": 1.0,
    "MaxBatchEventCount": 10
  },
  "ConfigService": [ "http://ecs.nova88dev.com:7242/" ]
}
